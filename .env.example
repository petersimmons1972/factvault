# Database
POSTGRES_DB=factvault
POSTGRES_USER=factvault
POSTGRES_PASSWORD=factvault
FACTVAULT_DATABASE_URL=postgres://factvault:factvault@postgres:5432/factvault?sslmode=disable

# Auth
FACTVAULT_JWT_PUBLIC_KEY=/run/secrets/factvault-jwt-public.pem
FACTVAULT_DEV_TENANT_ID=11111111-1111-1111-1111-111111111111

# External services
FACTVAULT_LLM_URL=http://ollama:11434/v1
FACTVAULT_LLM_MODEL=llama3.1:8b
FACTVAULT_LLM_API_KEY=
FACTVAULT_EMBEDDER_URL=http://embedder:8080
FACTVAULT_WAYBACK_URL=https://web.archive.org

# Workers
FACTVAULT_WORKER_LIMIT=100
FACTVAULT_VERIFY_AGE_DAYS=7
FACTVAULT_COLLECTOR_SEED_URL=https://example.com/factvault-seed

# API
FACTVAULT_API_ADDR=:8080
FACTVAULT_MCP_TRANSPORT=stdio
