# Database
POSTGRES_DB=factvault
POSTGRES_USER=factvault
POSTGRES_PASSWORD=factvault
# Password for the app_user login role created by deploy/initdb/01-create-app-user.sh on first Postgres init.
# *** MUST be overridden for any non-local deployment (staging, CI, production). ***
# The default is intentionally named to discourage reuse outside local dev.
POSTGRES_APP_USER_PASSWORD=dev_only_local_password
# Application services (api, workers, mcp) connect as app_user — same role as production —
# so the schema's GRANTs are exercised end-to-end. The migrate container uses the superuser
# DSN below (FACTVAULT_MIGRATE_DATABASE_URL) because CREATE EXTENSION requires superuser.
FACTVAULT_DATABASE_URL=postgres://app_user:dev_only_local_password@postgres:5432/factvault?sslmode=disable
# Superuser DSN used by `factvault migrate` to run CREATE EXTENSION + DDL.
FACTVAULT_MIGRATE_DATABASE_URL=postgres://factvault:factvault@postgres:5432/factvault?sslmode=disable
FACTVAULT_POSTGRES_IMAGE=ankane/pgvector:latest
FACTVAULT_POSTGRES_PORT=5432

# Auth
FACTVAULT_AUTH_DIR=/var/lib/factvault/auth
FACTVAULT_JWT_PUBLIC_KEY=/var/lib/factvault/auth/factvault-jwt-public.pem
FACTVAULT_JWT_PRIVATE_KEY=/var/lib/factvault/auth/factvault-jwt-private.pem
FACTVAULT_DEV_TENANT_ID=11111111-1111-1111-1111-111111111111

# External services
# C2: FACTVAULT_LLM_BASE_URL is canonical; FACTVAULT_LLM_URL is a deprecated alias.
FACTVAULT_LLM_BASE_URL=http://ollama:11434/v1
# FACTVAULT_LLM_URL=http://ollama:11434/v1  # deprecated alias — triggers a stderr warning; use FACTVAULT_LLM_BASE_URL
FACTVAULT_LLM_MODEL=llama3.1:8b  # override for production (e.g. qwen3:32b)
FACTVAULT_LLM_API_KEY=
FACTVAULT_EMBEDDER_URL=http://embedder:8080
FACTVAULT_WAYBACK_URL=https://web.archive.org
# C5: SearXNG base URL for the worker research subcommand.
FACTVAULT_SEARXNG_URL=https://searxng.example.com
FACTVAULT_OLLAMA_PORT=11434
FACTVAULT_EMBEDDER_PORT=8081

# Workers
FACTVAULT_WORKER_LIMIT=100
FACTVAULT_VERIFY_AGE_DAYS=7
FACTVAULT_WORKER_INTERVAL_SECONDS=300

# API
FACTVAULT_API_ADDR=:8080
FACTVAULT_API_PORT=8080
# FACTVAULT_MCP_TRANSPORT is no longer a supported env var (C5 pruned).
# MCP transport is configured via the mcp server command flags only.
# MCP server default bearer token. Set this when the MCP client (e.g. Claude Desktop, Cursor)
# cannot inject an `authorization` parameter into individual tool calls. The value must be a
# valid RS256 JWT issued by `factvault auth token`. NEVER put a real token value here --
# generate one at runtime with:
#   factvault auth token --private-key .local/private.pem --tenant "$FACTVAULT_DEV_TENANT_ID"
# FACTVAULT_MCP_AUTH_TOKEN=
