{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/petersimmons1972/factvault/.agent-comms/schema.json",
  "title": "AgentMessage",
  "description": "A message exchanged between Claude (coordinator) and Codex (executor) via the filesystem message bus.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "from", "to", "ts", "kind", "refs", "body"],
  "properties": {
    "id": {
      "type": "string",
      "description": "ULID identifier for this message.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "from": {
      "type": "string",
      "description": "Sender agent.",
      "enum": ["claude", "codex"]
    },
    "to": {
      "type": "string",
      "description": "Recipient agent.",
      "enum": ["claude", "codex"]
    },
    "ts": {
      "type": "string",
      "description": "ISO 8601 timestamp when the message was written.",
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "description": "Message kind — determines processing semantics.",
      "enum": ["question", "answer", "nudge", "block", "handoff", "ack"]
    },
    "refs": {
      "type": "array",
      "description": "References to GitHub issues, PRs, commits, source locations, or other messages.",
      "items": {
        "type": "string"
      }
    },
    "in_reply_to": {
      "type": ["string", "null"],
      "description": "ULID of the message this is a reply to, or null if not a reply.",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "body": {
      "type": "string",
      "description": "Human-readable message content."
    }
  }
}
